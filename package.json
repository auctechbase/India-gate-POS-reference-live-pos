{
  "name": "india-gate-pos",
  "productName": "India Gate POS",
  "version": "1.0.1",
  "description": "India Gate POS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . India-Gate-POS --icon=pos.ico",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "electron-builder",
    "backend": "node backend/server.js"
  },
  "repository": {},
  "build": {
    "appId": "com.indiagate.pos",
    "productName": "India Gate POS",
    "win": {
      "icon": "pos.ico",
      "target": "nsis",
      "shortcutName": "India Gate POS",
      "createDesktopShortcut": true
    },
    "files": [
      "!**/node_modules/**/*.md",
      "!**/node_modules/**/test/**",
      "!**/node_modules/**/example/**",
      "!tests/**",
      "!storage/logs"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "bwip-js": "^4.5.1"
  }
}
