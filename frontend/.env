# Baked into the build at compile time (values recovered from the original build).
# The new POS backend runs on port 5101 (the original POS uses 5100).
REACT_APP_BACKEND_URI=http://localhost:5101/
REACT_APP_IMAGE_URI=http://localhost:5101/images/
# The original build shipped source maps; keep them so it can be debugged/recovered.
GENERATE_SOURCEMAP=true
